{
  "name": "fixo-app",
  "version": "1.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios:dev": "expo run:ios",
    "ios:build": "expo prebuild --clean && expo run:ios",
    "build:ios:prod:local": "npx expo run:ios --configuration Release",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"App.tsx\"",
    "code:style": "npm run lint && npm run format:check && npm run typecheck",
    "test": "jest --forceExit --silent",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production --local",
    "submit:ios": "eas submit --platform ios --profile production",
    "publish:ios": "npm run code:style && npm run test && bash scripts/publish-ios.sh $npm_config_bump"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@react-native-firebase/.*|@react-native-google-signin/.*|@sentry/react-native|native-base|react-native-svg|nativewind|react-native-css-interop|react-native-reanimated)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-firebase/app": "23.8.6",
    "@react-native-firebase/auth": "23.8.6",
    "@react-native-firebase/crashlytics": "23.8.6",
    "@react-native-firebase/firestore": "23.8.6",
    "@react-native-google-signin/google-signin": "16.1.1",
    "@react-navigation/bottom-tabs": "7.15.2",
    "@react-navigation/native": "7.1.31",
    "@react-navigation/native-stack": "7.14.2",
    "expo": "~55.0.3",
    "expo-apple-authentication": "~55.0.8",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "^55.0.7",
    "expo-crypto": "~55.0.8",
    "expo-dev-client": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-localization": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.8",
    "i18next": "^25.8.14",
    "nativewind": "4.2.2",
    "react": "19.2.0",
    "react-i18next": "^16.5.5",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "55.0.9",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.3.0",
    "jest-expo": "55.0.9",
    "prettier": "3.8.1",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1"
  },
  "private": true
}
